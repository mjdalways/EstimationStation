        + '<div style="font-size:clamp(0.9rem,2.5vw,1.3rem);color:rgba(255,220,100,0.9);font-weight:700;'
        + 'letter-spacing:.12em;text-transform:uppercase;">' + streak + ' IN A ROW</div>'
