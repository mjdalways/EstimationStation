<h3>4.4 <code>wwwroot/js/shame.js</code> — Full Skeleton</h3>
<pre><code><span class="kw">const</span> DEFAULT_SHAME = {
  <span class="op">animationStyle</span>:  <span class="str">'pulse'</span>,
  <span class="op">duration</span>:        <span class="num">6000</span>,
  <span class="op">shameColor</span>:      <span class="str">'#ff4444'</span>,
  <span class="op">floatingEmojis</span>:  <span class="kw">true</span>,
  <span class="op">emojis</span>:          [<span class="str">'🥲'</span>, <span class="str">'👎'</span>, <span class="str">'😤'</span>],
  <span class="op">booFontSize</span>:     <span class="num">48</span>,
  <span class="op">positiveMessage</span>: <span class="str">"But wait... maybe you're onto something. 🤔 State your case!"</span>,
  <span class="op">transitionDelay</span>: <span class="num">3000</span>,
  <span class="op">cricketSfx</span>:      <span class="kw">false</span>,
  <span class="op">tumbleweed</span>:      <span class="kw">false</span>,
  <span class="op">displayLabel</span>:    <span class="str">'Lone Wolf'</span>
};

<span class="kw">function</span> <span class="fn">getShameSettings</span>() {
  <span class="kw">try</span> {
    <span class="kw">const</span> raw = localStorage.<span class="fn">getItem</span>(<span class="str">'es_shameSettings'</span>);
    <span class="kw">return</span> { ...DEFAULT_SHAME, ...(raw ? JSON.<span class="fn">parse</span>(raw) : {}) };
  } <span class="kw">catch</span> { <span class="kw">return</span> { ...DEFAULT_SHAME }; }
}

<span class="kw">function</span> <span class="fn">triggerShame</span>(name, participantId, majorityValue, outlierValue) {
  <span class="kw">const</span> s = <span class="fn">getShameSettings</span>();
  <span class="kw">const</span> badge = document.<span class="fn">querySelector</span>(<span class="str">`[data-participant-id="</span>${participantId}<span class="str">"]`</span>);

  badge?.style.<span class="fn">setProperty</span>(<span class="str">'--shame-color'</span>, s.shameColor);
  badge?.classList.<span class="fn">add</span>(<span class="str">'shame-highlight'</span>);
  badge?.dataset.style = s.animationStyle;
  <span class="kw">if</span> (s.animationStyle === <span class="str">'spotlight'</span>) <span class="fn">addBackdrop</span>();
  <span class="kw">if</span> (s.tumbleweed) <span class="fn">spawnTumbleweed</span>();
  <span class="kw">if</span> (s.cricketSfx) <span class="kw">new</span> Audio(<span class="str">'/sfx/cricket.mp3'</span>).<span class="fn">play</span>().<span class="fn">catch</span>(()=>{});

  <span class="kw">if</span> (s.floatingEmojis) {
    <span class="kw">const</span> rect = badge?.<span class="fn">getBoundingClientRect</span>();
    <span class="kw">for</span> (<span class="kw">let</span> i = <span class="num">0</span>; i &lt; <span class="num">6</span>; i++)
      <span class="fn">setTimeout</span>(() => <span class="fn">spawnBooEmoji</span>(s, rect), i * <span class="num">220</span>);
  }
  <span class="fn">showShameToast</span>(name, majorityValue, outlierValue, s);
  <span class="kw">if</span> (<span class="fn">isMe</span>(participantId) &amp;&amp; <span class="fn">canCounterSpell</span>()) <span class="fn">showCounterSpellButton</span>(badge);
  <span class="fn">setTimeout</span>(() => <span class="fn">cleanupShame</span>(badge), s.duration);
}

<span class="kw">function</span> <span class="fn">testShame</span>() {
  <span class="kw">const</span> me = <span class="fn">getMyParticipant</span>();
  <span class="fn">triggerShame</span>(me.name, me.connectionId, <span class="str">'5'</span>, <span class="str">'13'</span>);
}</code></pre>

