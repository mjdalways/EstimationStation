                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-semibold mb-1">API token
                                    <a href="https://id.atlassian.com/manage-profile/security/api-tokens"
                                       target="_blank" rel="noopener" class="ms-1 small">(generate one)</a>
                                </label>
                                <input type="password" id="jiraToken" class="form-control form-control-sm"
                                       placeholder="••••••••••••••••" autocomplete="current-password" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold mb-1">Default JQL</label>
                                <input type="text" id="jiraJql" class="form-control form-control-sm"
                                       placeholder="project = MYPROJ AND sprint in openSprints() ORDER BY rank" />
                                <div class="form-text">Import imports up to 50 issues.</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold mb-1">Story Points Field ID <small class="text-muted">(write-back only)</small></label>
                                <input type="text" id="jiraFieldId" class="form-control form-control-sm"
                                       placeholder="customfield_10016" />
                                <div class="form-text" style="font-size:0.68rem;">
                                    Classic: <code>customfield_10016</code> · Next-gen: <code>customfield_10028</code>. Find it in Project Settings → Fields.
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-primary" onclick="saveJiraSettings()">💾 Save</button>
                                <button class="btn btn-sm btn-outline-secondary" onclick="clearJiraSettings()">🗑️ Clear</button>
                            </div>
                            <div id="jiraSettingsStatus" class="small mt-2"></div>
                        </div>
                    </div><!-- end tab-jira -->

                    <!-- ══════════════════════════════════════════
                         TAB: ⚙️ Other
                         ══════════════════════════════════════════ -->
                    <div class="tab-pane fade h-100 overflow-auto p-3" id="tab-other" role="tabpanel">

                        <!-- P1: Keyboard Shortcuts -->
                        <div class="settings-section-header" data-bs-toggle="collapse" data-bs-target="#kb-shortcuts-section">
                            ⌨️ Keyboard Shortcuts <span class="settings-section-chevron">▾</span>
                        </div>
                        <div id="kb-shortcuts-section" class="collapse show">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="kb-shortcuts-toggle"
                                       onchange="if(typeof toggleKbShortcuts==='function') toggleKbShortcuts(this.checked)">
                                <label class="form-check-label small" for="kb-shortcuts-toggle">Show shortcut legend below voting cards</label>
                            </div>
                            <p class="small text-muted mb-3">
                                <kbd>1</kbd>–<kbd>9</kbd> select nth card &nbsp;·&nbsp;
                                <kbd>C</kbd> ☕ &nbsp;·&nbsp; <kbd>Q</kbd> ? &nbsp;·&nbsp; <kbd>−</kbd> skip vote &nbsp;·&nbsp;
                                <kbd>,</kbd>/<kbd>←</kbd> prev &nbsp;·&nbsp; <kbd>.</kbd>/<kbd>→</kbd> next &nbsp;·&nbsp;
                                <kbd>Space</kbd>/<kbd>Enter</kbd> reveal &nbsp;·&nbsp;
                                <kbd>R</kbd> reset &nbsp;·&nbsp; <kbd>F</kbd> fullscreen
                            </p>
                        </div>

                        <!-- P2: Emoji Reactions -->
                        <div class="settings-section-header" data-bs-toggle="collapse" data-bs-target="#reaction-section">
                            💬 Emoji Reactions <span class="settings-section-chevron">▾</span>
                        </div>
                        <div id="reaction-section" class="collapse show mb-3">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="reaction-enabled-toggle"
                                       onchange="if(typeof saveReactionSettings==='function') saveReactionSettings()">
                                <label class="form-check-label small" for="reaction-enabled-toggle">Show emoji reaction bar in room</label>
                            </div>
                            <div class="mb-1 small">Reaction palette (up to 8, space-separated):</div>
                            <div class="input-group input-group-sm" style="max-width:280px;">
                                <input type="text" id="reaction-palette-input" class="form-control"
                                       style="font-size:1rem;" placeholder="👍 👏 🎉 😂 ❤️ 🔥 😮 💡"
                                       data-picker-target
                                       oninput="if(typeof saveReactionSettings==='function') saveReactionSettings()">
                            </div>
                            <p class="small text-muted mt-1 mb-0">Click a reaction during estimation to broadcast it — floats up from your participant badge. Rate-limited to 1 per 2 seconds.</p>
                        </div>

                        <!-- AC3/AC4: Timer & Clock settings -->
                        <div class="d-flex align-items-center border-bottom pb-1 mb-2">
                            <h6 class="text-muted mb-0 me-auto">⏱️ Timer &amp; Clock</h6>
                        </div>
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" id="tc-show-timer" onchange="saveTimerClockSettings()">
                            <label class="form-check-label small" for="tc-show-timer">Show count-up timer</label>
                        </div>
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="tc-show-clock" onchange="saveTimerClockSettings()">
                            <label class="form-check-label small" for="tc-show-clock">Show clock</label>
                        </div>
                        <div class="mb-2 d-flex align-items-center gap-2 small">
                            <label class="text-nowrap" for="tc-timezone">Timezone</label>
                            <select id="tc-timezone" class="form-select form-select-sm" style="max-width:230px;" onchange="saveTimerClockSettings()">
                                <option value="">Local (browser)</option>
                                <optgroup label="Americas">
                                    <option value="America/New_York">New York (ET)</option>
                                    <option value="America/Chicago">Chicago (CT)</option>
                                    <option value="America/Denver">Denver (MT)</option>
                                    <option value="America/Los_Angeles">Los Angeles (PT)</option>
                                    <option value="America/Toronto">Toronto (ET)</option>
                                    <option value="America/Vancouver">Vancouver (PT)</option>
                                    <option value="America/Sao_Paulo">São Paulo (BRT)</option>
                                </optgroup>
                                <optgroup label="Europe">
                                    <option value="Europe/London">London (GMT/BST)</option>
                                    <option value="Europe/Paris">Paris (CET)</option>
                                    <option value="Europe/Berlin">Berlin (CET)</option>
                                    <option value="Europe/Amsterdam">Amsterdam (CET)</option>
                                    <option value="Europe/Stockholm">Stockholm (CET)</option>
                                    <option value="Europe/Warsaw">Warsaw (CET)</option>
                                    <option value="Europe/Athens">Athens (EET)</option>
                                    <option value="Europe/Istanbul">Istanbul (TRT)</option>
                                    <option value="Europe/Moscow">Moscow (MSK)</option>
                                </optgroup>
                                <optgroup label="Africa / Middle East">
                                    <option value="Africa/Cairo">Cairo (EET)</option>
                                    <option value="Africa/Johannesburg">Johannesburg (SAST)</option>
                                    <option value="Asia/Dubai">Dubai (GST)</option>
                                </optgroup>
                                <optgroup label="Asia">
                                    <option value="Asia/Karachi">Karachi (PKT)</option>
                                    <option value="Asia/Kolkata">Mumbai/Kolkata (IST)</option>
                                    <option value="Asia/Dhaka">Dhaka (BST)</option>
                                    <option value="Asia/Bangkok">Bangkok (ICT)</option>
                                    <option value="Asia/Singapore">Singapore (SGT)</option>
                                    <option value="Asia/Hong_Kong">Hong Kong (HKT)</option>
                                    <option value="Asia/Shanghai">Shanghai (CST)</option>
                                    <option value="Asia/Tokyo">Tokyo (JST)</option>
                                    <option value="Asia/Seoul">Seoul (KST)</option>
                                </optgroup>
                                <optgroup label="Pacific / Oceania">
                                    <option value="Australia/Sydney">Sydney (AEST)</option>
                                    <option value="Australia/Melbourne">Melbourne (AEST)</option>
                                    <option value="Australia/Perth">Perth (AWST)</option>
                                    <option value="Pacific/Auckland">Auckland (NZST)</option>
                                    <option value="Pacific/Honolulu">Honolulu (HST)</option>
                                </optgroup>
                                <optgroup label="UTC">
                                    <option value="UTC">UTC</option>
                                </optgroup>
                            </select>
                        </div>
                        <div class="mb-2 small">
                            <span class="me-3">Mode</span>
                            <label class="me-3"><input type="radio" name="tc-mode" value="digital" onchange="saveTimerClockSettings();_tcToggleMode('digital')"> Digital</label>
                            <label><input type="radio" name="tc-mode" value="analog" onchange="saveTimerClockSettings();_tcToggleMode('analog')"> Analog</label>
                        </div>
                        <div id="tc-digital-opts" class="mb-3 d-flex flex-wrap gap-3 align-items-center small">
                            <label>Color <input type="color" id="tc-color" value="#6c757d" onchange="saveTimerClockSettings()" style="width:36px;height:22px;padding:1px;border:none;cursor:pointer;vertical-align:middle;"></label>
                            <label>Size <input type="number" id="tc-font-size" value="13" min="10" max="22" style="width:50px;" class="form-control form-control-sm d-inline-block" onchange="saveTimerClockSettings()">px</label>
                        </div>
                        <div id="tc-analog-opts" class="mb-3 small" style="display:none;">
                            <div class="d-flex flex-wrap gap-3 align-items-center mb-2">
                                <label>Face <select id="tc-face" class="form-select form-select-sm d-inline-block" style="width:100px;" onchange="saveTimerClockSettings()"><option value="minimal">Minimal</option><option value="classic">Classic</option><option value="filled">Filled</option></select></label>
                                <label>Hour <input type="color" id="tc-hour-color" value="#212529" onchange="saveTimerClockSettings()" style="width:36px;height:22px;padding:1px;border:none;cursor:pointer;vertical-align:middle;"></label>
                                <label>Min <input type="color" id="tc-min-color" value="#495057" onchange="saveTimerClockSettings()" style="width:36px;height:22px;padding:1px;border:none;cursor:pointer;vertical-align:middle;"></label>
                                <label>Sec <input type="color" id="tc-sec-color" value="#dc3545" onchange="saveTimerClockSettings()" style="width:36px;height:22px;padding:1px;border:none;cursor:pointer;vertical-align:middle;"></label>
                            </div>
                        </div>

                        <!-- Mobile Animations -->
                        <div class="d-flex align-items-center border-bottom pb-1 mb-2 mt-3">
                            <h6 class="text-muted mb-0 me-auto">📱 Mobile</h6>
                        </div>
                        <div class="form-check form-check-sm mb-2">
                            <input class="form-check-input" type="checkbox" id="cel-mobile-animations"
                                   onchange="saveCelebrationSettingsFromForm()">
                            <label class="form-check-label small" for="cel-mobile-animations">
                                Enable animations on mobile (may affect performance)
                            </label>
                        </div>

                        <!-- PWA / App Install -->
                        <div class="d-flex align-items-center border-bottom pb-1 mb-2 mt-3">
                            <h6 class="text-muted mb-0 me-auto">📲 App Install</h6>
                        </div>
                        <p class="small text-muted mb-2">Add Estimation Station to your home screen for a full-screen, offline-capable experience.</p>
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="installApp()">📲 Add to Home Screen</button>
                        <p class="small text-muted mt-2 mb-0">Button only appears when your browser supports installation.</p>

                    </div><!-- end tab-other -->

                </div><!-- end tab-content -->
            </div>
        </div>
    </div><!-- end settingsModal -->

    <!-- ═══════════════════════════════════════════════════════
         Battle Arena overlay (hidden until triggerBattle fires)
         ═══════════════════════════════════════════════════════ -->
    <div id="battle-arena" style="display:none;" aria-hidden="true">
        <div id="ba-stage">
            <!-- Crowd -->
            <div id="ba-crowd"></div>

            <!-- HUD -->
            <div id="ba-hud">
                <div class="ba-fighter-hud">
                    <div class="ba-fighter-name" id="ba-name-left"></div>
                    <div class="ba-fighter-vote-badge" id="ba-vote-left"></div>
                    <div class="ba-hp-wrap"><div class="ba-hp-bar" id="ba-hp-left" style="width:100%"></div></div>
                </div>
                <div class="ba-hud-mid">
                    <div class="ba-hud-vs-icon">⚔️</div>
                    <div class="ba-round-label">Battle</div>
                </div>
                <div class="ba-fighter-hud ba-hud-right">
                    <div class="ba-fighter-name" id="ba-name-right"></div>
                    <div class="ba-fighter-vote-badge" id="ba-vote-right"></div>
                    <div class="ba-hp-wrap"><div class="ba-hp-bar" id="ba-hp-right" style="width:100%"></div></div>
                </div>
            </div>

            <!-- Fighters -->
            <div id="ba-fighters">
                <div class="ba-fighter" id="ba-fighter-left"></div>
                <div class="ba-fighter" id="ba-fighter-right"></div>
            </div>

            <!-- VS screen flash -->
            <div id="ba-vs-screen">
                <span class="ba-vs-text">VS</span>
            </div>

            <!-- Mid-battle announcements -->
            <div id="ba-announcement">
                <div id="ba-ann-text"></div>
            </div>

            <!-- Winner banner -->
            <div id="ba-winner-banner">
                <div class="ba-winner-name" id="ba-winner-name"></div>
                <div class="ba-winner-label">Winner!</div>
            </div>

            <!-- Skip -->
            <button id="ba-skip-btn" onclick="skipBattle()">Skip ⏭</button>
        </div>
    </div>

    <!-- Session Awards Modal -->
    <div class="modal fade" id="awardsModal" tabindex="-1" aria-labelledby="awardsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width:460px;">
            <div class="modal-content">
                <div class="modal-header py-2 border-bottom">
                    <h5 class="modal-title fs-6 fw-bold" id="awardsModalLabel">🏆 Session Awards</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3 px-4" id="awards-modal-content"></div>
            </div>
        </div>
    </div>

    <!-- Session Analytics Modal -->
    <div class="modal fade" id="analyticsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width:500px;">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title fw-bold">📊 Session Analytics</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3 px-4" id="analytics-modal-content" style="max-height:65vh;overflow-y:auto;"></div>
            </div>
        </div>
    </div>

    <!-- Season Animation Config Modal -->
    <div class="modal fade" id="seaConfigModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width:520px;">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title fw-bold" id="seaConfigModalLabel">⚙️ Season Config</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3 px-3" id="seaConfigModalBody" style="max-height:65vh;overflow-y:auto;"></div>
                <div class="modal-footer py-2 gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetSeasonConfig()">↩ Reset defaults</button>
                    <button type="button" class="btn btn-primary btn-sm" onclick="saveSeasonConfig()">💾 Save</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Decider Wheel Modal -->
    <div class="modal fade" id="deciderModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
            <div class="modal-content text-center">
                <div class="modal-header py-2">
                    <h6 class="modal-title fw-bold">🎡 The Decider</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-4">
                    <div id="deciderWheel" style="width:280px;height:280px;margin:0 auto;position:relative;cursor:pointer;" onclick="spinDecider()">
                        <canvas id="deciderCanvas" width="280" height="280"></canvas>
                    </div>
                    <div id="deciderResult" style="font-size:1.4rem;font-weight:800;margin-top:16px;min-height:2rem;"></div>
                </div>
                <div class="modal-footer py-2 justify-content-center">
                    <button class="btn btn-primary" onclick="spinDecider()">🎰 Spin</button>
                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- N5: Sound Confirmation Modal -->
    <div class="modal fade" id="soundConfirmModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered" style="max-width:400px;">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title fw-bold">🔊 Sound Preferences</h6>
                </div>
                <div class="modal-body py-3">
                    <p class="small mb-3">Sounds are configured for this room. How would you like to hear them this session?</p>
                    <div class="d-grid gap-2">
                        <button class="btn btn-outline-primary text-start" onclick="confirmSoundChoice('all')"><b>🔊 All sounds</b> — hear your own and others' sounds</button>
                        <button class="btn btn-outline-secondary text-start" onclick="confirmSoundChoice('local')"><b>🎵 My sounds only</b> — local triggers, no received broadcasts</button>
                        <button class="btn btn-outline-secondary text-start" onclick="confirmSoundChoice('broadcast')"><b>📻 Received only</b> — hear others' sounds, not your own</button>
                        <button class="btn btn-outline-danger text-start" onclick="confirmSoundChoice('none')"><b>🔇 No sounds</b> — mute all for this session</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/emoji-picker.js" asp-append-version="true"></script>
    <!-- Celebration libraries (canvas-confetti + fireworks-js) loaded from CDN -->
    <script src="~/js/vendor/confetti.min.js" asp-append-version="true"></script>
    <script src="~/js/vendor/fireworks.umd.js" asp-append-version="true"></script>
    <script src="~/js/celebration.js" asp-append-version="true"></script>
    <script src="~/js/avatar.js" asp-append-version="true"></script>
    <script src="~/js/shame.js" asp-append-version="true"></script>
    <script src="~/js/battle.js" asp-append-version="true"></script>
    <script src="~/js/awards.js" asp-append-version="true"></script>
    <script src="~/js/seasonal.js" asp-append-version="true"></script>
    <script src="~/js/discussion.js" asp-append-version="true"></script>
    <script src="~/js/voice.js" asp-append-version="true"></script>
    <script src="~/js/counter-spell.js" asp-append-version="true"></script>
    <script src="~/js/audio.js" asp-append-version="true"></script>
    <script src="~/js/analytics.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        // Register service worker for PWA
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js').catch(err => console.warn('SW registration failed:', err));
        }
        // Restore ambient audio from saved settings
        if (typeof applyAmbientFromSettings === 'function') applyAmbientFromSettings();
        // Wraps test functions: applies body.test-mode so DOM effects render above modal (z-index > 1055)
        function runTest(fn) {
            document.body.classList.add('test-mode');
            try { fn(); } catch(e) {}
            setTimeout(function() { document.body.classList.remove('test-mode'); }, 5000);
        }
        // Fix aria-hidden warning: blur focused element inside settingsModal before Bootstrap hides it
        (function() {
            var m = document.getElementById('settingsModal');
            if (m) m.addEventListener('hide.bs.modal', function() {
                if (m.contains(document.activeElement)) document.activeElement.blur();
            });
        })();
    </script>
</body>
</html>
