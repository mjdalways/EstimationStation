<h3>6.7 Phase Orchestrator (<code>battle.js</code>)</h3>
<pre><code><span class="kw">async function</span> <span class="fn">triggerBattle</span>(groups) {
  <span class="kw">const</span> s   = <span class="fn">getBattleSettings</span>();
  <span class="kw">const</span> mul = { slow: <span class="num">1.5</span>, normal: <span class="num">1</span>, fast: <span class="num">0.65</span> }[s.speed] ?? <span class="num">1</span>;
  <span class="kw">const</span> arena = <span class="fn">buildArena</span>(groups, s);
  document.body.<span class="fn">appendChild</span>(arena);

  <span class="kw">await</span> <span class="fn">sleep</span>(<span class="num">1500</span> * mul);  <span class="fn">runLineup</span>(arena);
  <span class="kw">await</span> <span class="fn">sleep</span>(<span class="num">1500</span> * mul);  <span class="fn">runTaunt</span>(arena, groups);

  <span class="kw">const</span> clashes = <span class="fn">clashCountFor</span>(groups);   <span class="cm">// 2–4 based on team count</span>
  <span class="kw">for</span> (<span class="kw">let</span> i = <span class="num">0</span>; i &lt; clashes; i++) {
    <span class="kw">await</span> <span class="fn">runOneClash</span>(arena, s, i);
  }

  <span class="kw">await</span> <span class="fn">sleep</span>(<span class="num">300</span> * mul); <span class="fn">runAftermath</span>(arena, s);
  <span class="kw">await</span> <span class="fn">sleep</span>(<span class="num">2500</span> * mul); <span class="fn">runResolution</span>(arena, s);
  <span class="kw">if</span> (s.autoSkipMs > <span class="num">0</span>) <span class="fn">setTimeout</span>(() => <span class="fn">dismissBattle</span>(), s.autoSkipMs);
}</code></pre>

