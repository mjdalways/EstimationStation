<h3>Post-Reveal Dispatch Logic (<code>room.js</code>)</h3>
<pre><code>connection.on(<span class="str">'VotesRevealed'</span>, (votes, stats) => {
  <span class="kw">const</span> beh    = <span class="fn">getPostRevealBehavior</span>();
  <span class="kw">const</span> groups = <span class="fn">buildVoteGroups</span>(roomState.participants, votes);

  <span class="cm">// Boss fight visual wraps the whole reveal if the ticket qualifies</span>
  <span class="kw">if</span> (beh.bossFightEnabled &amp;&amp; <span class="fn">currentCardIsBoss</span>(beh.bossFightMinPoints)) {
    <span class="fn">enterBossArena</span>(stats);
  }

  <span class="kw">if</span> (stats.isConsensus) {
    <span class="kw">if</span> (beh.celebrationEnabled) <span class="fn">triggerCelebration</span>(stats);
    <span class="kw">if</span> (beh.streaksEnabled)     <span class="fn">incrementStreak</span>(stats);
    <span class="kw">if</span> (beh.finisherEnabled &amp;&amp; <span class="fn">isHardWonConsensus</span>(stats)) <span class="fn">triggerFinisher</span>();
    <span class="kw">return</span>;
  } <span class="kw">else if</span> (beh.streaksEnabled) {
    <span class="fn">resetStreak</span>();
  }

  <span class="kw">const</span> hasOutlier = !!stats.shameParticipantId;
  <span class="kw">const</span> hasBattle  = groups.length >= <span class="num">2</span>
                  &amp;&amp; <span class="fn">totalVoters</span>(groups) >= beh.minVotersForBattle;

  <span class="kw">if</span> (hasOutlier &amp;&amp; beh.shameEnabled
      &amp;&amp; (beh.outlierBehavior === <span class="str">'shame-only'</span> || beh.outlierBehavior === <span class="str">'both'</span>)) {
    <span class="fn">triggerShame</span>(stats.shameParticipantName, stats.shameParticipantId,
                  stats.majorityValue, stats.outlierValue);
  }

  <span class="kw">const</span> shameBlocksBattle = hasOutlier &amp;&amp; beh.outlierBehavior === <span class="str">'shame-only'</span>;
  <span class="kw">if</span> (hasBattle &amp;&amp; beh.battleEnabled &amp;&amp; !shameBlocksBattle) {
    <span class="kw">if</span> (beh.duelEnabled &amp;&amp; <span class="fn">isStraightOneVOne</span>(groups)) {
      <span class="fn">triggerDuelOfPerspective</span>(groups);
    } <span class="kw">else</span> {
      <span class="fn">triggerBattle</span>(groups);
    }
  }

  <span class="kw">if</span> (beh.discussionTimerMode !== <span class="str">'off'</span>) {
    <span class="fn">startDiscussionTimer</span>(beh.discussionTimerMode, beh.discussionThresholdMin);
  }
});</code></pre>

<h2 id="shame">4. Top-Priority — Shame (a.k.a. The Lone Wolf)</h2>

<div class="callout info">
  <strong>Trigger Condition</strong>
  After votes are revealed: exactly one participant voted a different numeric value from all others (n−1 voters agree on value X; 1 voter chose value Y). Non-numeric votes (?, ☕) are excluded. The outlier is called out with animation and emoji, then the overlay transitions to a positive message encouraging them to make their case.
</div>

<div class="callout note">
  <strong>Naming note from Gemini brainstorm</strong>
  Gemini proposed renaming this from "Shame" to "The Lone Wolf" or "The Holdout" with a spotlight + cricket effect for lighthearted framing. The plan keeps <code>Shame</code> as the internal mechanic name (existing copy) but exposes <b>display label "Lone Wolf"</b> in the settings UI and adds a <b>cricket SFX</b> + <b>tumbleweed</b> option in §4.6.
</div>

<h3>4.1 Backend — <code>PokerModels.cs</code></h3>
<pre><code><span class="kw">public class</span> <span class="cs">VoteStats</span>
{
    <span class="kw">public</span> <span class="cs">double</span>?  Average                { <span class="kw">get</span>; <span class="kw">set</span>; }
    <span class="kw">public</span> <span class="cs">string</span>?  Min                    { <span class="kw">get</span>; <span class="kw">set</span>; }
    <span class="kw">public</span> <span class="cs">string</span>?  Max                    { <span class="kw">get</span>; <span class="kw">set</span>; }
    <span class="kw">public</span> <span class="cs">bool</span>     IsConsensus            { <span class="kw">get</span>; <span class="kw">set</span>; }
    <span class="kw">public</span> <span class="cs">string</span>?  ShameParticipantName   { <span class="kw">get</span>; <span class="kw">set</span>; }  <span class="cm">// NEW</span>
    <span class="kw">public</span> <span class="cs">string</span>?  ShameParticipantId     { <span class="kw">get</span>; <span class="kw">set</span>; }  <span class="cm">// NEW — SignalR ConnectionId</span>
    <span class="kw">public</span> <span class="cs">string</span>?  MajorityValue          { <span class="kw">get</span>; <span class="kw">set</span>; }  <span class="cm">// NEW</span>
    <span class="kw">public</span> <span class="cs">string</span>?  OutlierValue           { <span class="kw">get</span>; <span class="kw">set</span>; }  <span class="cm">// NEW</span>
    <span class="kw">public</span> <span class="cs">int</span>      ConsensusStreak        { <span class="kw">get</span>; <span class="kw">set</span>; }  <span class="cm">// NEW v2</span>
    <span class="kw">public</span> <span class="cs">bool</span>     IsGodlike              { <span class="kw">get</span>; <span class="kw">set</span>; }  <span class="cm">// NEW v2</span>
}</code></pre>

<h3>4.2 Backend — <code>PokerHub.cs</code> — Outlier Detection</h3>
<p>Appended to <code>CalculateStats()</code> after the existing consensus check:</p>
<pre><code><span class="cm">// Single-outlier detection</span>
<span class="kw">if</span> (!stats.IsConsensus &amp;&amp; numericVotes.Count >= <span class="num">2</span>)
{
    <span class="kw">var</span> groups = numericVotes
        .GroupBy(kvp => kvp.Value)
        .OrderByDescending(g => g.Count())
        .ToList();

    <span class="kw">if</span> (groups.Count == <span class="num">2</span> &amp;&amp; groups[<span class="num">1</span>].Count() == <span class="num">1</span>)
    {
        <span class="kw">var</span> outlierId = groups[<span class="num">1</span>].First().Key;   <span class="cm">// ConnectionId</span>
        <span class="kw">var</span> outlier   = room.Participants
            .FirstOrDefault(p => p.ConnectionId == outlierId);
        <span class="kw">if</span> (outlier != <span class="kw">null</span>)
        {
            stats.ShameParticipantName = outlier.Name;
            stats.ShameParticipantId   = outlierId;
            stats.MajorityValue        = groups[<span class="num">0</span>].Key;
            stats.OutlierValue         = groups[<span class="num">1</span>].Key;
        }
    }
}</code></pre>

