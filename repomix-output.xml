<file path="Controllers/HomeController.cs">
using System.Diagnostics;
using Microsoft.AspNetCore.Mvc;
using EstimationStation.Models;

namespace EstimationStation.Controllers;

public class HomeController : Controller
{
    public IActionResult Index(string? room)
    {
        ViewData["InviteRoom"] = room;
        return View();
    }

    public IActionResult Privacy()
    {
        return View();
    }

    [ResponseCache(Duration = 0, Location = ResponseCacheLocation.None, NoStore = true)]
    public IActionResult Error()
    {
        return View(new ErrorViewModel { RequestId = Activity.Current?.Id ?? HttpContext.TraceIdentifier });
    }
}
</file>

<file path="Controllers/RoomController.cs">
using Microsoft.AspNetCore.Mvc;
using EstimationStation.Models;

namespace EstimationStation.Controllers;

public class RoomController : Controller
{
    public IActionResult Index(string roomName, string name)
    {
        if (string.IsNullOrWhiteSpace(roomName))
            return RedirectToAction("Index", "Home");

        if (string.IsNullOrWhiteSpace(name))
            return RedirectToAction("Index", "Home", new { room = roomName });

        var model = new RoomViewModel
        {
            RoomName = roomName,
            PlayerName = name
        };

        return View(model);
    }
}
</file>

<file path="FEATURE-PLAN-3.0.html">
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EstimationStation — Feature Plan v3.0</title>
<style>
  :root {
    --bg: #0f1117; --bg2: #1a1d27; --bg3: #22263a;
    --border: #2e3350; --accent: #5b8dee; --accent2: #a78bfa;
    --green: #34d399; --red: #f87171; --yellow: #fbbf24; --orange: #fb923c;
    --pink: #f472b6; --cyan: #22d3ee;
    --text: #e2e8f0; --muted: #8892a4; --code-bg: #0d1117;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: 'Segoe UI', system-ui, sans-serif; background: var(--bg); color: var(--text);
         line-height: 1.7; font-size: 15px; }

  .layout { display: flex; min-height: 100vh; }
  nav.sidebar { width: 280px; min-width: 280px; background: var(--bg2);
                border-right: 1px solid var(--border); position: sticky;
                top: 0; height: 100vh; overflow-y: auto; padding: 24px 0; }
  nav.sidebar .logo { padding: 0 20px 20px; border-bottom: 1px solid var(--border); margin-bottom: 16px; }
  nav.sidebar .logo h2 { font-size: 1rem; color: var(--accent); }
  nav.sidebar .logo p  { font-size: 0.75rem; color: var(--muted); margin-top: 4px; }
  nav.sidebar a { display: block; padding: 5px 20px; color: var(--muted);
                  text-decoration: none; font-size: 0.8rem; border-left: 3px solid transparent;
                  transition: all 0.15s; }
  nav.sidebar a:hover, nav.sidebar a.active
    { color: var(--text); border-left-color: var(--accent); background: rgba(91,141,238,0.08); }
  nav.sidebar .nav-section { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em;
                              color: var(--muted); padding: 14px 20px 4px; }
  main { flex: 1; max-width: 1100px; padding: 48px 56px; overflow-x: hidden; }

  h1 { font-size: 2.2rem; font-weight: 800; background: linear-gradient(135deg, var(--accent), var(--accent2));
       -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 8px; }
  h2 { font-size: 1.5rem; font-weight: 700; color: var(--accent); margin: 48px 0 16px;
       padding-bottom: 8px; border-bottom: 2px solid var(--border); }
  h3 { font-size: 1.15rem; font-weight: 700; color: var(--accent2); margin: 32px 0 12px; }
  h4 { font-size: 1rem; font-weight: 600; color: var(--yellow); margin: 24px 0 8px; }
  h5 { font-size: 0.9rem; font-weight: 600; color: var(--green); margin: 18px 0 6px; }
  p  { margin-bottom: 12px; color: var(--text); }

  .hero { background: linear-gradient(135deg, #1a1d2e, #252a40);
          border: 1px solid var(--border); border-radius: 16px;
          padding: 32px 36px; margin-bottom: 40px; }
  .hero h1 { margin-bottom: 12px; }
  .hero .meta { display: flex; gap: 24px; flex-wrap: wrap; margin-top: 16px; }
  .hero .meta span { font-size: 0.82rem; color: var(--muted);
                     background: var(--bg3); border: 1px solid var(--border);
                     padding: 4px 12px; border-radius: 20px; }
  .hero .meta span b { color: var(--text); }

  .callout { border-radius: 10px; padding: 16px 20px; margin: 20px 0; border-left: 4px solid; }
  .callout.info  { background: rgba(91,141,238,0.08); border-color: var(--accent); }
  .callout.warn  { background: rgba(251,191,36,0.08);  border-color: var(--yellow); }
  .callout.good  { background: rgba(52,211,153,0.08);  border-color: var(--green); }
  .callout.note  { background: rgba(167,139,250,0.08); border-color: var(--accent2); }
  .callout.danger{ background: rgba(248,113,113,0.08); border-color: var(--red); }
  .callout strong { display: block; margin-bottom: 4px; font-size: 0.85rem;
                    text-transform: uppercase; letter-spacing: 0.05em; }
  .callout.info  strong { color: var(--accent); }
  .callout.warn  strong { color: var(--yellow); }
  .callout.good  strong { color: var(--green); }
  .callout.note  strong { color: var(--accent2); }
  .callout.danger strong { color: var(--red); }

  .table-wrap { overflow-x: auto; margin: 16px 0; border-radius: 10px;
                border: 1px solid var(--border); }
  table { width: 100%; border-collapse: collapse; }
  th { background: var(--bg3); color: var(--accent); font-size: 0.8rem;
       text-transform: uppercase; letter-spacing: 0.06em;
       padding: 10px 16px; text-align: left; border-bottom: 1px solid var(--border); }
  td { padding: 10px 16px; border-bottom: 1px solid var(--border);
       vertical-align: top; font-size: 0.88rem; }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: rgba(255,255,255,0.02); }

  pre { background: var(--code-bg); border: 1px solid var(--border); border-radius: 10px;
        padding: 20px; overflow-x: auto; margin: 16px 0; font-size: 0.82rem; line-height: 1.6; }
  code { font-family: 'Cascadia Code', 'Fira Code', 'Consolas', monospace; }
  pre code { color: #c9d1d9; }
  :not(pre) > code { background: var(--bg3); color: var(--accent2);
                     padding: 2px 6px; border-radius: 4px; font-size: 0.85em; }

  .badge { display: inline-block; padding: 2px 9px; border-radius: 12px;
           font-size: 0.75rem; font-weight: 600; margin: 2px; }
  .badge-blue   { background: rgba(91,141,238,0.2); color: var(--accent); border: 1px solid rgba(91,141,238,0.4); }
  .badge-purple { background: rgba(167,139,250,0.2); color: var(--accent2); border: 1px solid rgba(167,139,250,0.4); }
  .badge-green  { background: rgba(52,211,153,0.2);  color: var(--green);   border: 1px solid rgba(52,211,153,0.4); }
  .badge-yellow { background: rgba(251,191,36,0.2);  color: var(--yellow);  border: 1px solid rgba(251,191,36,0.4); }
  .badge-red    { background: rgba(248,113,113,0.2); color: var(--red);     border: 1px solid rgba(248,113,113,0.4); }
  .badge-orange { background: rgba(251,146,60,0.2);  color: var(--orange);  border: 1px solid rgba(251,146,60,0.4); }
  .badge-pink   { background: rgba(244,114,182,0.2); color: var(--pink);    border: 1px solid rgba(244,114,182,0.4); }
  .badge-cyan   { background: rgba(34,211,238,0.2);  color: var(--cyan);    border: 1px solid rgba(34,211,238,0.4); }

  hr { border: none; border-top: 1px solid var(--border); margin: 36px 0; }
  ul { margin: 10px 0 10px 24px; }
  ul li { margin-bottom: 6px; font-size: 0.9rem; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .muted { color: var(--muted); font-size: 0.85rem; }

  .feature-card { background: var(--bg2); border: 1px solid var(--border);
                  border-radius: 12px; padding: 16px 20px; margin: 12px 0; }
  .feature-card h4 { color: var(--yellow); margin: 0 0 6px; font-size: 0.95rem; }
  .feature-card p  { color: var(--muted); font-size: 0.84rem; margin: 0 0 4px; }
  .feature-card ul { margin: 6px 0 0 18px; }
  .feature-card ul li { color: var(--text); font-size: 0.84rem; margin-bottom: 3px; }

  .group-card { background: var(--bg2); border: 1px solid rgba(91,141,238,0.3);
                border-radius: 12px; padding: 20px 24px; margin: 16px 0; }
  .group-card h3 { color: var(--accent); margin: 0 0 6px; font-size: 1.05rem; }
  .group-card .tag { font-size: 0.72rem; background: rgba(91,141,238,0.15); color: var(--accent);
                     border: 1px solid rgba(91,141,238,0.3); padding: 2px 8px; border-radius: 8px;
                     margin-right: 6px; }
  .group-card.hard { border-color: rgba(248,113,113,0.35); }
  .group-card.hard h3 { color: var(--red); }
  .group-card.hard .tag { background: rgba(248,113,113,0.12); color: var(--red);
                           border-color: rgba(248,113,113,0.3); }

  .plan-file { font-size:0.75rem; background: rgba(52,211,153,0.1); color: var(--green);
               border: 1px solid rgba(52,211,153,0.3); padding: 2px 8px;
               border-radius: 6px; margin-left: 6px; font-family: monospace; }

  .seasonal-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 16px 0; }
  .sea-event { background: var(--bg3); border: 1px solid var(--border); border-radius: 8px;
               padding: 10px 12px; }
  .sea-event .sea-name { font-size: 0.85rem; font-weight: 600; color: var(--text); }
  .sea-event .sea-date { font-size: 0.73rem; color: var(--muted); margin-top: 2px; }
  .sea-event .sea-p { font-size: 0.68rem; padding: 1px 6px; border-radius: 6px; margin-top: 4px;
                      display: inline-block; font-weight: 700; }
  .p1 { background: rgba(248,113,113,0.2); color: var(--red); }
  .p2 { background: rgba(251,191,36,0.2); color: var(--yellow); }
  .p3 { background: rgba(34,211,238,0.2); color: var(--cyan); }
  .p4 { background: rgba(52,211,153,0.2); color: var(--green); }

  td.status-done   { color: var(--green); font-weight: 600; }
  td.status-pending { color: var(--yellow); }
  td.status-invest { color: var(--cyan); }
  td.status-wontdo { color: var(--red); opacity: 0.7; }

  @media (max-width: 900px) {
    nav.sidebar { display: none; }
    main { padding: 24px 20px; }
    .seasonal-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
</head>
