<h3>5.3 Backend — <code>PokerHub.cs</code> — <code>UpdateAvatar</code></h3>
<pre><code><span class="kw">public async</span> Task <span class="fn">UpdateAvatar</span>(<span class="cs">string</span> avatarData)
{
    <span class="kw">if</span> (avatarData?.<span class="fn">StartsWith</span>(<span class="str">"data:"</span>) == <span class="kw">true</span> &amp;&amp; avatarData.Length > <span class="num">65_536</span>)
    {
        <span class="kw">await</span> Clients.Caller.<span class="fn">SendAsync</span>(<span class="str">"Error"</span>, <span class="str">"Avatar image too large (max ~48 KB)."</span>);
        <span class="kw">return</span>;
    }
    <span class="kw">var</span> roomName    = _roomService.<span class="fn">GetRoomForConnection</span>(Context.ConnectionId);
    <span class="kw">var</span> room        = _roomService.<span class="fn">GetRoom</span>(roomName);
    <span class="kw">var</span> participant = room?.Participants
        .FirstOrDefault(p => p.ConnectionId == Context.ConnectionId);
    <span class="kw">if</span> (participant == <span class="kw">null</span>) <span class="kw">return</span>;
    participant.AvatarData = avatarData;
    <span class="kw">await</span> Clients.Group(roomName).<span class="fn">SendAsync</span>(<span class="str">"AvatarUpdated"</span>, Context.ConnectionId, avatarData);
}</code></pre>

<div class="callout note">
