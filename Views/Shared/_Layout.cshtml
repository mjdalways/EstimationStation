    <div class="modal fade" id="awardsModal" tabindex="-1" aria-labelledby="awardsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width:460px;">
            <div class="modal-content">
                <div class="modal-header py-2 border-bottom">
                    <h5 class="modal-title fs-6 fw-bold" id="awardsModalLabel">🏆 Session Awards</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3 px-4" id="awards-modal-content"></div>
            </div>
        </div>
    </div>

    <!-- Session Analytics Modal -->
    <div class="modal fade" id="analyticsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width:500px;">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title fw-bold">📊 Session Analytics</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3 px-4" id="analytics-modal-content" style="max-height:65vh;overflow-y:auto;"></div>
            </div>
        </div>
    </div>

    <!-- Season Animation Config Modal -->
    <div class="modal fade" id="seaConfigModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width:520px;">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title fw-bold" id="seaConfigModalLabel">⚙️ Season Config</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3 px-3" id="seaConfigModalBody" style="max-height:65vh;overflow-y:auto;"></div>
                <div class="modal-footer py-2 gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetSeasonConfig()">↩ Reset defaults</button>
                    <button type="button" class="btn btn-primary btn-sm" onclick="saveSeasonConfig()">💾 Save</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Decider Wheel Modal -->
    <div class="modal fade" id="deciderModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
            <div class="modal-content text-center">
                <div class="modal-header py-2">
                    <h6 class="modal-title fw-bold">🎡 The Decider</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-4">
                    <div id="deciderWheel" style="width:280px;height:280px;margin:0 auto;position:relative;cursor:pointer;" onclick="spinDecider()">
                        <canvas id="deciderCanvas" width="280" height="280"></canvas>
                    </div>
                    <div id="deciderResult" style="font-size:1.4rem;font-weight:800;margin-top:16px;min-height:2rem;"></div>
                </div>
                <div class="modal-footer py-2 justify-content-center">
                    <button class="btn btn-primary" onclick="spinDecider()">🎰 Spin</button>
                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- Celebration libraries (canvas-confetti + fireworks-js) loaded from CDN -->
    <script src="~/js/vendor/confetti.min.js" asp-append-version="true"></script>
    <script src="~/js/vendor/fireworks.umd.js" asp-append-version="true"></script>
    <script src="~/js/celebration.js" asp-append-version="true"></script>
    <script src="~/js/avatar.js" asp-append-version="true"></script>
    <script src="~/js/shame.js" asp-append-version="true"></script>
    <script src="~/js/battle.js" asp-append-version="true"></script>
    <script src="~/js/awards.js" asp-append-version="true"></script>
    <script src="~/js/seasonal.js" asp-append-version="true"></script>
    <script src="~/js/discussion.js" asp-append-version="true"></script>
    <script src="~/js/voice.js" asp-append-version="true"></script>
    <script src="~/js/counter-spell.js" asp-append-version="true"></script>
    <script src="~/js/audio.js" asp-append-version="true"></script>
    <script src="~/js/analytics.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        // Register service worker for PWA
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js').catch(err => console.warn('SW registration failed:', err));
        }
        // Restore ambient audio from saved settings
        if (typeof applyAmbientFromSettings === 'function') applyAmbientFromSettings();
        // Wraps test functions: applies body.test-mode so DOM effects render above modal (z-index > 1055)
        function runTest(fn) {
            document.body.classList.add('test-mode');
            try { fn(); } catch(e) {}
            setTimeout(function() { document.body.classList.remove('test-mode'); }, 5000);
        }
        // Fix aria-hidden warning: blur focused element inside settingsModal before Bootstrap hides it
        (function() {
            var m = document.getElementById('settingsModal');
            if (m) m.addEventListener('hide.bs.modal', function() {
                if (m.contains(document.activeElement)) document.activeElement.blur();
            });
        })();
    </script>
</body>
</html>


