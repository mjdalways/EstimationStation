                </div><!-- end tab-content -->
            </div>
        </div>
    </div><!-- end settingsModal -->

    <!-- ═══════════════════════════════════════════════════════
         Battle Arena overlay (hidden until triggerBattle fires)
         ═══════════════════════════════════════════════════════ -->
    <div id="battle-arena" style="display:none;" aria-hidden="true">
        <div id="ba-stage">
            <!-- Crowd -->
            <div id="ba-crowd"></div>

            <!-- HUD -->
            <div id="ba-hud">
                <div class="ba-fighter-hud">
                    <div class="ba-fighter-name" id="ba-name-left"></div>
                    <div class="ba-fighter-vote-badge" id="ba-vote-left"></div>
                    <div class="ba-hp-wrap"><div class="ba-hp-bar" id="ba-hp-left" style="width:100%"></div></div>
                </div>
                <div class="ba-hud-mid">
                    <div class="ba-hud-vs-icon">⚔️</div>
                    <div class="ba-round-label">Battle</div>
                </div>
                <div class="ba-fighter-hud ba-hud-right">
                    <div class="ba-fighter-name" id="ba-name-right"></div>
                    <div class="ba-fighter-vote-badge" id="ba-vote-right"></div>
                    <div class="ba-hp-wrap"><div class="ba-hp-bar" id="ba-hp-right" style="width:100%"></div></div>
                </div>
            </div>

            <!-- Fighters -->
            <div id="ba-fighters">
                <div class="ba-fighter" id="ba-fighter-left"></div>
                <div class="ba-fighter" id="ba-fighter-right"></div>
            </div>

            <!-- VS screen flash -->
            <div id="ba-vs-screen">
                <span class="ba-vs-text">VS</span>
            </div>

            <!-- Mid-battle announcements -->
            <div id="ba-announcement">
                <div id="ba-ann-text"></div>
            </div>

            <!-- Winner banner -->
            <div id="ba-winner-banner">
                <div class="ba-winner-name" id="ba-winner-name"></div>
                <div class="ba-winner-label">Winner!</div>
            </div>

            <!-- Skip -->
            <button id="ba-skip-btn" onclick="skipBattle()">Skip ⏭</button>
        </div>
    </div>

    <!-- Session Awards Modal -->
    <div class="modal fade" id="awardsModal" tabindex="-1" aria-labelledby="awardsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width:460px;">
            <div class="modal-content">
                <div class="modal-header py-2 border-bottom">
                    <h5 class="modal-title fs-6 fw-bold" id="awardsModalLabel">🏆 Session Awards</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3 px-4" id="awards-modal-content"></div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- Celebration libraries (canvas-confetti + fireworks-js) loaded from CDN -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1/dist/confetti.browser.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fireworks-js@2/dist/index.umd.js"></script>
    <script src="~/js/celebration.js" asp-append-version="true"></script>
    <script src="~/js/avatar.js" asp-append-version="true"></script>
    <script src="~/js/shame.js" asp-append-version="true"></script>
    <script src="~/js/battle.js" asp-append-version="true"></script>
    <script src="~/js/awards.js" asp-append-version="true"></script>
    <script src="~/js/seasonal.js" asp-append-version="true"></script>
    <script src="~/js/discussion.js" asp-append-version="true"></script>
    <script src="~/js/voice.js" asp-append-version="true"></script>
    <script src="~/js/counter-spell.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        // Register service worker for PWA
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js').catch(err => console.warn('SW registration failed:', err));
        }
    </script>
</body>
</html>


