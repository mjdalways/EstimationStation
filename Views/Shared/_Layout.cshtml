                            <div class="d-flex flex-wrap gap-3 align-items-center mb-2">
                                <label>Face <select id="tc-face" class="form-select form-select-sm d-inline-block" style="width:100px;" onchange="saveTimerClockSettings()"><option value="minimal">Minimal</option><option value="classic">Classic</option><option value="filled">Filled</option></select></label>
                                <label>Size <input type="number" id="tc-analog-size" value="52" min="30" max="120" style="width:55px;" class="form-control form-control-sm d-inline-block" onchange="saveTimerClockSettings()">px</label>
                                <label>Hour <input type="color" id="tc-hour-color" value="#212529" oninput="saveTimerClockSettings()" onchange="saveTimerClockSettings()" style="width:36px;height:22px;padding:1px;border:none;cursor:pointer;vertical-align:middle;"></label>
