    <!-- Decider Wheel Modal -->
    <div class="modal fade" id="deciderModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
            <div class="modal-content text-center">
                <div class="modal-header py-2">
                    <h6 class="modal-title fw-bold">🎡 The Decider</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-4">
                    <div id="deciderWheel" style="width:280px;height:280px;margin:0 auto;position:relative;cursor:pointer;" onclick="spinDecider()">
                        <canvas id="deciderCanvas" width="280" height="280"></canvas>
                    </div>
                    <div id="deciderResult" style="font-size:1.4rem;font-weight:800;margin-top:16px;min-height:2rem;"></div>
                </div>
                <div class="modal-footer py-2 justify-content-center">
                    <button class="btn btn-primary" onclick="spinDecider()">🎰 Spin</button>
                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- N5: Sound Confirmation Modal -->
    <div class="modal fade" id="soundConfirmModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered" style="max-width:400px;">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title fw-bold">🔊 Sound Preferences</h6>
                </div>
                <div class="modal-body py-3">
                    <p class="small mb-3">Sounds are configured for this room. How would you like to hear them this session?</p>
                    <div class="d-grid gap-2">
                        <button class="btn btn-outline-primary text-start" onclick="confirmSoundChoice('all')"><b>🔊 All sounds</b> — hear your own and others' sounds</button>
                        <button class="btn btn-outline-secondary text-start" onclick="confirmSoundChoice('local')"><b>🎵 My sounds only</b> — local triggers, no received broadcasts</button>
                        <button class="btn btn-outline-secondary text-start" onclick="confirmSoundChoice('broadcast')"><b>📻 Received only</b> — hear others' sounds, not your own</button>
                        <button class="btn btn-outline-danger text-start" onclick="confirmSoundChoice('none')"><b>🔇 No sounds</b> — mute all for this session</button>
                    </div>
                    <div class="form-check form-switch mt-3 pt-2 border-top">
                        <input class="form-check-input" type="checkbox" role="switch" id="sound-choice-always" />
                        <label class="form-check-label small text-muted" for="sound-choice-always">Always use this option (skip prompt in future)</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

