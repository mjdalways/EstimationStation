    @await RenderSectionAsync("Scripts", required: false)
    <script>
        // Register service worker for PWA
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js').catch(err => console.warn('SW registration failed:', err));
        }
        // Restore ambient audio from saved settings
        if (typeof applyAmbientFromSettings === 'function') applyAmbientFromSettings();
        // Wraps test functions: applies body.test-mode so DOM effects render above modal (z-index > 1055)
        function runTest(fn) {
            document.body.classList.add('test-mode');
            try { fn(); } catch(e) {}
            setTimeout(function() { document.body.classList.remove('test-mode'); }, 5000);
        }
        // Fix aria-hidden warning: blur focused element inside settingsModal before Bootstrap hides it
        (function() {
            var m = document.getElementById('settingsModal');
            if (m) m.addEventListener('hide.bs.modal', function() {
                if (m.contains(document.activeElement)) document.activeElement.blur();
            });
        })();
    </script>
</body>
</html>


