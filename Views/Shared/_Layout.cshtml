                                <label>Sec <input type="color" id="tc-sec-color" value="#dc3545" oninput="saveTimerClockSettings()" onchange="saveTimerClockSettings()" style="width:36px;height:22px;padding:1px;border:none;cursor:pointer;vertical-align:middle;"></label>
