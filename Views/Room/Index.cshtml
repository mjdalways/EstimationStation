@model EstimationStation.Models.RoomViewModel
@{
    ViewData["Title"] = Model.RoomName;
}

@section NavbarExtra {
<div class="d-flex align-items-center gap-2 flex-wrap">
    <span class="navbar-text" id="navRoomName">🏠 @Model.RoomName</span>
    <span class="navbar-text" id="navPlayerName">👤 <span id="displayName">@Model.PlayerName</span></span>
    <span id="voice-mic-indicator" style="display:none;cursor:pointer;" title="Voice recognition active — click to stop" class="badge bg-danger ms-1" onclick="toggleVoiceRecognition()">
        🎤
        <span class="voice-bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </span>
    <button class="btn btn-sm btn-outline-info" onclick="copyInviteLink()" title="Copy room invite link">🔗 Invite</button>
    <button class="btn btn-sm btn-outline-light" onclick="promptRename()" title="Change display name">✏️</button>
    <button class="btn btn-sm btn-outline-warning" onclick="leaveRoom()">🚪 Leave</button>
</div>
}

<div class="room-layout" id="roomLayout">
    <!-- Left Panel: Stories -->
    <div class="stories-panel" id="storiesPanel">
        <div id="sidebar-resize-handle" aria-hidden="true"></div>
        <div class="panel-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0">📋 Stories</h6>
            <button class="btn btn-sm btn-outline-secondary d-md-none" onclick="_closeStoriesSheet()" title="Close stories panel">✕</button>
        </div>
        <div class="add-story-form">
            <input type="text" id="newStoryInput" class="form-control form-control-sm" placeholder="Add story..." maxlength="200" />
            <button class="btn btn-sm btn-primary w-100 mt-1" onclick="addStory()">+ Add Story</button>
            <details class="mt-2">
                <summary class="small text-muted" style="cursor:pointer;">📋 Import multiple stories…</summary>
                <textarea id="importStoriesInput" class="form-control form-control-sm mt-1" rows="4"
                          placeholder="Paste one story per line..."></textarea>
                <button class="btn btn-sm btn-outline-primary w-100 mt-1" onclick="importStories()">Import All</button>
            </details>
            <details class="mt-2" id="jiraImportDetails">
                <summary class="small text-muted" style="cursor:pointer;">🔗 Import from Jira…</summary>
                <div class="mt-1">
                    <input type="text" id="jiraImportJql" class="form-control form-control-sm"
                           placeholder="JQL — e.g. sprint in openSprints() ORDER BY rank" />
                    <div id="jiraImportCreds" class="small text-warning mt-1" style="display:none;">
                        ⚠️ Jira credentials not set — <a href="#" onclick="openSettingsModal('jira');return false;">configure in Settings → Jira</a>
                    </div>
                    <button class="btn btn-sm btn-outline-primary w-100 mt-1" onclick="importFromJira()">🔗 Import from Jira</button>
                    <div id="jiraImportStatus" class="small mt-1"></div>
                </div>
            </details>
        </div>
        <div id="storiesList" class="stories-list"></div>
        <div id="sprintDashboard" class="px-1 pt-1 border-top" style="display:none;">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted" style="font-size:0.72rem;">Sprint total</span>
                <span id="sprintTotal" class="fw-bold text-success" style="font-size:0.8rem;">0 pts</span>
            </div>
            <div id="sprintSparkline" style="height:30px; overflow:hidden;"></div>
            <div id="sprintVelocityWrap" class="mt-1" style="display:none;">
                <span class="text-muted" style="font-size:0.65rem;">Past sessions</span>
                <div id="sprintVelocityChart" style="height:26px; overflow:hidden;"></div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Current Story Bar -->
        <div class="current-story-bar">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="story-label">Current Story:</span>
                <span id="currentStoryDisplay" class="current-story-title">No story selected</span>
                <span id="pinBadge" style="display:none;" class="badge bg-warning text-dark ms-1" title="Room has PIN">🔒</span>
                <div id="timerDisplay" class="timer-display" style="display:none;">
                    <span id="timerIcon">⏱️</span> <span id="timerValue">0</span>s
                </div>
                <!-- AC: Session Timer + Clock — inline right side -->
                <div id="session-tc-bar" class="ms-auto d-flex align-items-center gap-2" style="display:none;">
                    <span id="stc-timer" class="stc-segment" title="Time on current story"></span>
                    <span class="stc-sep" id="stc-sep">·</span>
                    <span id="stc-clock" class="stc-segment"></span>
                </div>
            </div>
        </div>
        <div id="currentStoryNote" class="current-story-note" style="display:none;"></div>

        <!-- Stats Bar (shown when votes revealed) -->
        <div id="statsBar" class="stats-bar" style="display:none;">
            <div class="stat-item">
                <span class="stat-label">Average</span>
                <span class="stat-value" id="statAverage">-</span>
            </div>
            <div class="stat-item">
                <span class="stat-label">Min</span>
                <span class="stat-value" id="statMin">-</span>
            </div>
            <div class="stat-item">
                <span class="stat-label">Max</span>
                <span class="stat-value" id="statMax">-</span>
            </div>
            <div id="consensusBadge" class="consensus-badge" style="display:none;">
                🎉 Consensus!
            </div>
            <div id="voteDistBar" style="display:none;flex:0 0 100%;margin-top:4px;"></div>
            <div id="hotColdMeter" style="display:none;flex:0 0 100%;font-size:0.8rem;margin-top:2px;"></div>
            <div style="flex:0 0 100%;margin-top:6px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                <button id="acceptEstimateBtn" class="btn btn-sm btn-success py-0 px-2"
                        onclick="acceptEstimate()" style="font-size:0.8rem;"
                        title="Sets the final estimate for this story and marks it complete">✅ Accept &amp; Add to Story <span id="acceptEstimateValue"></span></button>
                <input id="acceptEstimateInput" type="text" class="form-control form-control-sm"
                       style="width:70px;font-size:0.8rem;" placeholder="override"
                       oninput="_updateAcceptBtnLabel(this.value)" />
            </div>
        </div>

        <!-- Counter-Spell Bar (shown to outlier only after non-consensus reveal) -->
        <div id="counterSpellBar" class="counter-spell-bar" style="display:none;"></div>

        <!-- Vibe Check Panel -->
        <div id="vibeCheckPanel" style="margin-bottom:10px;padding:8px 12px;background:var(--bg-secondary,#f8f9fa);border:1px solid var(--panel-border,#dee2e6);border-radius:10px;">
            <div style="font-size:0.75rem;font-weight:600;color:var(--text-secondary,#6c757d);margin-bottom:6px;">🌡️ Vibe Check — how does this sprint feel?</div>
            <div id="vibeButtons" style="display:flex;gap:6px;flex-wrap:wrap;"></div>
            <div id="vibeSummary" style="font-size:0.72rem;color:var(--text-secondary,#6c757d);margin-top:5px;min-height:1em;"></div>
        </div>

        <!-- Voting Cards -->
        <div class="voting-section">
            <h6 class="section-label">Your Vote</h6>
            <div id="cardContainer" class="card-container"></div>
            <!-- P1: keyboard shortcut legend (populated by JS) -->
            <div id="keyboard-legend" class="keyboard-legend" style="display:none;"></div>
            <!-- P2: emoji reaction bar (populated by JS) -->
            <div id="reactionPanel" class="reaction-panel" style="display:none;"></div>
        </div>

        <!-- Confidence selector (shown after voting, hidden on reveal/reset) -->
        <div id="confidenceSelector" style="display:none; margin-bottom:12px; text-align:center;">
            <div class="small text-muted mb-1">How confident are you?</div>
            <div class="btn-group btn-group-sm" role="group">
                <button class="conf-btn btn btn-outline-warning" onclick="castConfidence(1)" title="Low">★</button>
                <button class="conf-btn btn btn-outline-warning" onclick="castConfidence(2)" title="">★★</button>
                <button class="conf-btn btn btn-outline-warning" onclick="castConfidence(3)" title="Medium">★★★</button>
                <button class="conf-btn btn btn-outline-warning" onclick="castConfidence(4)" title="">★★★★</button>
                <button class="conf-btn btn btn-outline-warning" onclick="castConfidence(5)" title="High">★★★★★</button>
            </div>
        </div>

        <!-- Participants -->
        <div class="participants-section">
            <h6 class="section-label">Participants</h6>
            <div id="participantsContainer" class="participants-container"></div>
        </div>

        <!-- Vote History (populated by JS after each reveal) -->
        <div class="vote-history-section" id="voteHistorySection" style="display:none;">
            <div class="d-flex align-items-center gap-2">
                <button class="vote-history-toggle" onclick="toggleVoteHistory()">
                    📜 Vote History <span id="voteHistoryChevron">▾</span>
                </button>
                <button class="btn btn-sm btn-outline-warning py-0 px-2" id="awards-trigger-btn"
                        onclick="showSessionAwards()" style="display:none;" title="Session Awards">🏆 Awards</button>
                <button class="btn btn-sm btn-outline-info py-0 px-2" id="analytics-trigger-btn"
                        onclick="showAnalyticsModal()" style="display:none;" title="Session Analytics">📊 Analytics</button>
            </div>
            <div id="voteHistoryList" class="vote-history-list" style="display:none;"></div>
        </div>
    </div>

    <!-- Right Controls Panel -->
    <div class="controls-panel">
        <div class="control-group">
            <h6 class="control-title">🎮 Controls</h6>
            <button class="btn btn-success w-100 mb-2" id="revealBtn" onclick="revealVotes()">👁️ Reveal</button>
            <button class="btn btn-secondary w-100 mb-2" id="hideBtn" onclick="hideVotes()" style="display:none;">🙈 Hide</button>
            <button class="btn btn-warning w-100 mb-2" onclick="resetVotes()">🔄 Reset</button>
            <button class="btn btn-outline-info w-100 mb-2" onclick="openDecider()">🎡 Decider</button>
            <button class="btn btn-outline-secondary w-100 mb-2" id="ghostToggleBtn" onclick="toggleGhostMode()" title="Latecomers join as ghosts (watch only) when on" data-room-setting="ghostMode">👻 Ghost: Off</button>
            <button id="pinBtn" class="btn btn-outline-secondary w-100 mb-2" onclick="openPinModal(false)" title="Set or clear room PIN">🔒 PIN</button>
        </div>

        <div class="control-group" id="room-settings-section">
            <h6 class="control-title">⚙️ Settings</h6>
            <div class="form-check mb-2" data-room-setting="autoReveal">
                <input class="form-check-input" type="checkbox" id="autoRevealCheck" onchange="toggleAutoReveal(this.checked)" />
                <label class="form-check-label" for="autoRevealCheck">Auto-reveal <span class="badge-room-setting" title="Shared with all room participants">👥</span></label>
            </div>
            <div class="form-check mb-2" data-room-setting="revealMajorityFirst">
                <input class="form-check-input" type="checkbox" id="revealMajorityCheck" checked onchange="toggleRevealOrdering(this.checked)" title="Outlier voter revealed last with a dramatic pause" />
                <label class="form-check-label" for="revealMajorityCheck" title="Outlier voter revealed last with a dramatic pause">Reveal majority first <span class="badge-room-setting" title="Shared with all room participants">👥</span></label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="observerCheck" onchange="toggleObserver(this.checked)" />
                <label class="form-check-label" for="observerCheck">Observer mode</label>
            </div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="skipVoteCheck" onchange="toggleSkipVoteCard(this.checked)" />
                <label class="form-check-label" for="skipVoteCheck">🚫 Skip card</label>
            </div>
            <!-- AD2: Host-only settings lock selector -->
            <div id="host-lock-section" data-host-only style="display:none;">
                <hr class="my-2" />
                <div class="mb-1 small fw-bold text-muted">🔒 Settings Lock</div>
                <select class="form-select form-select-sm" onchange="setSettingsLock(this.value)" id="settingsLockSelect">
                    <option value="none">🔓 No lock — anyone can change</option>
                    <option value="ask">🙋 Ask first — host must approve</option>
                    <option value="hostonly">🔒 Host only (disabled for others)</option>
                    <option value="hidden">🙈 Host only (hidden from others)</option>
                </select>
                <div class="text-muted mt-1" style="font-size:0.68rem;">Only room-level settings (👥) are locked. Personal settings are always individual.</div>
            </div>
        </div>

        <div class="control-group" data-room-setting="estimateSet">
            <h6 class="control-title">🎯 Estimate Set <span class="badge-room-setting" title="Shared with all room participants">👥</span></h6>
            <select id="estimateSetSelect" class="form-select form-select-sm mb-2" onchange="changeEstimateSet(this.value)">
                <option value="fibonacci">Fibonacci</option>
                <option value="modified-fibonacci">Modified Fibonacci</option>
                <option value="t-shirt">T-Shirt</option>
                <option value="powers-of-2">Powers of 2</option>
                <option value="custom">Custom</option>
            </select>
            <div id="customEstimatesDiv" style="display:none;">
                <input type="text" id="customEstimatesInput" class="form-control form-control-sm mb-1" placeholder="1,2,3,5,8..." />
                <button class="btn btn-sm btn-primary w-100" onclick="applyCustomEstimates()">Apply</button>
            </div>
        </div>

        <div class="control-group">
            <h6 class="control-title">⏱️ Timer</h6>
            <div class="d-flex gap-1 flex-wrap mb-2">
                <button class="btn btn-sm btn-outline-primary" onclick="startTimer(30)">30s</button>
                <button class="btn btn-sm btn-outline-primary" onclick="startTimer(60)">1m</button>
                <button class="btn btn-sm btn-outline-primary" onclick="startTimer(90)">90s</button>
                <button class="btn btn-sm btn-outline-primary" onclick="startTimer(180)">3m</button>
                <button class="btn btn-sm btn-outline-primary" onclick="startTimer(300)">5m</button>
            </div>
            <button class="btn btn-sm btn-outline-danger w-100" onclick="stopTimer()">⏹️ Stop Timer</button>
        </div>

        <div class="control-group">
            <h6 class="control-title">🔊 Sounds</h6>
            <div class="d-flex flex-wrap gap-1 mb-2">
                <button class="btn btn-sm btn-outline-secondary" onclick="playSound('bell')" title="Bell">🔔</button>
                <button class="btn btn-sm btn-outline-secondary" onclick="playSound('fanfare')" title="Fanfare">🎉</button>
                <button class="btn btn-sm btn-outline-secondary" onclick="playSound('drumroll')" title="Drumroll">🥁</button>
                <button class="btn btn-sm btn-outline-secondary" onclick="playSound('airhorn')" title="Air Horn">📯</button>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="soundBroadcastCheck" />
                <label class="form-check-label" for="soundBroadcastCheck">Broadcast to room</label>
            </div>
        </div>

        <div class="control-group">
            <button class="btn btn-sm btn-outline-secondary w-100" onclick="exportCSV()">📥 Export CSV</button>
        </div>
    </div>
</div>

<!-- Chat Panel (collapsible bottom) -->
<div class="chat-panel" id="chatPanel">
    <div class="chat-header" onclick="toggleChat()">
        💬 Chat <span id="chatToggleIcon">▼</span>
    </div>
    <div class="chat-body" id="chatBody" style="display:none;">
        <div id="chatMessages" class="chat-messages"></div>
        <div class="chat-input-row">
            <input type="text" id="chatInput" class="form-control form-control-sm" placeholder="Type a message..." maxlength="500" />
            <button class="btn btn-sm btn-primary" onclick="sendChat()">Send</button>
        </div>
    </div>
</div>

<!-- Mobile Bottom Navigation Bar -->
<nav class="mobile-bottom-nav d-lg-none" id="mobileBottomNav">
    <button class="mobile-nav-btn" onclick="toggleMobilePanel('controls')" id="mobileControlsBtn">
        <span class="mobile-nav-icon">⚙️</span>
        <span class="mobile-nav-label">Controls</span>
    </button>
</nav>

<!-- PIN Modal -->
<div id="pinModal" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title mb-0" id="pinModalTitle">🔒 Room PIN</h6>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-2">
                <div id="pinModalMsg" class="text-muted small mb-2" style="display:none;"></div>
                <input id="pinInput" type="password" class="form-control form-control-sm"
                       maxlength="8" placeholder="Enter PIN (blank to remove)"
                       onkeydown="if(event.key==='Enter') submitPin()">
            </div>
            <div class="modal-footer py-1 gap-2">
                <button class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-sm btn-primary" onclick="submitPin()" id="pinSubmitBtn">Set PIN</button>
            </div>
        </div>
    </div>
</div>

<div id="storiesPanelBackdrop" onclick="_closeStoriesSheet()"></div>

@section Scripts {
<script>
    const ROOM_CONFIG = {
        roomName: @Json.Serialize(Model.RoomName),
        playerName: @Json.Serialize(Model.PlayerName)
    };

    // Mobile panel toggling
    function toggleMobilePanel(panel) {
        const panels = {
            controls: { el: document.querySelector('.controls-panel'), btn: document.getElementById('mobileControlsBtn') }
        };
        const target = panels[panel];
        if (!target) return;
        const isVisible = target.el.classList.contains('mobile-visible');
        Object.values(panels).forEach(p => { p.el.classList.remove('mobile-visible'); if (p.btn) p.btn.classList.remove('active'); });
        if (!isVisible) { target.el.classList.add('mobile-visible'); if (target.btn) target.btn.classList.add('active'); }
    }

    function scrollToCards() {
        const el = document.getElementById('cardContainer');
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        el.classList.add('card-flash');
        setTimeout(() => el.classList.remove('card-flash'), 700);
    }

    async function copyInviteLink() {
        const inviteUrl = `${window.location.origin}/room/${encodeURIComponent(ROOM_CONFIG.roomName)}`;
        try {
            await navigator.clipboard.writeText(inviteUrl);
            alert('Invite link copied. Share it and users will be asked for their name before joining.');
        } catch {
            prompt('Copy this invite link:', inviteUrl);
        }
    }
</script>
<script src="~/js/shame.js" asp-append-version="true"></script>
<script src="~/js/room.js" asp-append-version="true"></script>
}
